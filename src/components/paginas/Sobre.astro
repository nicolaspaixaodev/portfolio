---
import { Image } from "astro:assets";
import Contato from "../Contato.astro";
import { textos, type Lang } from "../../i18n/ui";
import { sobre } from "../../data/sobre";
import { site } from "../../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = textos(lang);
const temFoto = Boolean(sobre.foto);
---

<div class:list={["sobre", temFoto ? "sobre-com-foto" : "sobre-sem-foto"]}>
  <h1 class="display sobre-titulo" data-split>{t.sobre}</h1>

  {
    sobre.foto && (
      <figure class="sobre-foto" data-anim="agua">
        <Image src={sobre.foto} alt={sobre.fotoAlt?.[lang] ?? ""} widths={[480, 960]} sizes="(min-width: 1024px) 32vw, 100vw" />
      </figure>
    )
  }

  <p class="sobre-abertura" data-split="linhas">{sobre.paragrafos[lang][0]}</p>

  <div class="sobre-texto" data-anim data-atraso="0.3">
    {sobre.paragrafos[lang].slice(1).map((paragrafo) => <p>{paragrafo}</p>)}
  </div>

  <dl class="sobre-ficha" data-anim data-atraso="0.4">
    <div>
      <dt class="rotulo">{t.ferramentas}</dt>
      {sobre.ferramentas.map((linha) => <dd>{linha}</dd>)}
    </div>
    <div>
      <dt class="rotulo">{t.formacao}</dt>
      {sobre.formacao[lang].map((linha) => <dd>{linha}</dd>)}
    </div>
  </dl>

  <footer class="sobre-rodape" data-anim data-atraso="0.5">
    <Contato lang={lang} />
    <p class="rotulo">{t.base} · © {site.ano}<br />{t.creditos}</p>
  </footer>
</div>

<style>
  .sobre {
    display: grid;
    gap: 2.5rem;
    padding: 2rem var(--margem) 6rem;
  }

  .sobre-titulo {
    font-size: calc((100vw - 2 * var(--margem)) / 3.6);
  }

  .sobre-foto :global(img) {
    width: 100%;
  }

  .sobre-abertura {
    max-width: 28ch;
    font-size: clamp(1.4rem, 2.5vw, 2.35rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .sobre-texto {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
    font-size: var(--texto-corpo);
    line-height: 1.55;
  }

  .sobre-texto p {
    text-wrap: pretty;
  }

  .sobre-ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.5rem 2rem;
    max-width: 38rem;
  }

  .sobre-ficha > div {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }

  .sobre-rodape {
    display: grid;
    gap: 1.5rem;
  }

  @media (max-width: 1023px) {
    .sobre-rodape :global(.contato-whatsapp) {
      position: fixed;
      right: var(--margem);
      bottom: var(--margem);
      z-index: 20;
      border: 1.5px solid var(--tinta);
    }
  }

  @media (min-width: 1024px) {
    .sobre {
      min-height: 100svh;
      padding: calc(var(--cab-h) + 1rem) var(--margem) 2rem;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
      column-gap: 4vw;
      row-gap: 2rem;
    }

    .sobre-titulo {
      grid-column: 1 / -1;
      font-size: min(11vw, 6rem);
    }

    .sobre-abertura {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .sobre-texto {
      grid-column: 1;
      grid-row: 3;
      align-self: end;
      max-width: 36rem;
    }

    .sobre-ficha {
      grid-column: 2;
      grid-row: 3;
      align-self: end;
      max-width: none;
    }

    .sobre-rodape {
      grid-column: 1 / -1;
      grid-row: 4;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .sobre-com-foto .sobre-titulo,
    .sobre-com-foto .sobre-abertura {
      grid-column: 1;
    }

    .sobre-com-foto .sobre-foto {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: start;
      width: min(100%, 28rem);
      justify-self: end;
      margin-top: 0.5rem;
    }
  }
</style>
